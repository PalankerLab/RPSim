proc basic_shape() {
  shape3d_1()
  shape3d_2()
  shape3d_3()
  shape3d_4()
  shape3d_5()
  shape3d_6()
  shape3d_7()
  shape3d_8()
  shape3d_9()
}

objref all, somatic, axonal, dendritic
proc subsets() { local i
  objref all, somatic, axonal, dendritic
  all = new SectionList()
    soma all.append()
    for i=0, 73 dend[i] all.append()
	for i = 0, 19 axon[i] all.append()

  somatic = new SectionList()
    soma somatic.append()

  axonal = new SectionList()
	for i = 0, 19 axon[i] axonal.append()

  dendritic = new SectionList()
    for i=0, 73 dend[i] dendritic.append()

}
proc geom() {
}
proc geom_nseg() {
	soma.nseg = 1
	for i=0, 73 dend[i].nseg=dend[i].L / 5 + 1
	for i=0, 19 axon[i].nseg = axon[i].L/5 + 1

}

celldef()
access soma

