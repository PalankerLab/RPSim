proc celldef() {
  topol()
  subsets()
  geom()
  geom_nseg()
}

create soma, dend[74], axon[20]

proc topol() { local i
  connect dend[73](0), soma(1)
  connect dend[0](0), dend[73](1)
  for i = 1, 4 connect dend[i](0), dend[i-1](1)
  connect dend[5](0), dend[3](1)
