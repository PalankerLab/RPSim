  for i = 14, 15 connect dend[i](0), dend[13](1)
  connect dend[16](0), dend[8](1)
  for i = 17, 18 connect dend[i](0), dend[0](1)
  for i = 19, 20 connect dend[i](0), dend[18](1)
  connect dend[21](0), dend[73](1)
  for i = 22, 23 connect dend[i](0), dend[21](1)
  for i = 24, 25 connect dend[i](0), dend[23](1)
  connect dend[26](0), dend[73](1)
  for i = 27, 29 connect dend[i](0), dend[i-1](1)
  connect dend[30](0), dend[28](1)
  for i = 31, 32 connect dend[i](0), dend[30](1)
  connect dend[33](0), dend[27](1)
  for i = 34, 35 connect dend[i](0), dend[33](1)
  connect dend[36](0), dend[26](1)
  for i = 37, 39 connect dend[i](0), dend[i-1](1)
  connect dend[40](0), dend[38](1)
  connect dend[41](0), dend[37](1)
  for i = 42, 43 connect dend[i](0), dend[41](1)
  connect dend[44](0), dend[36](1)
  for i = 45, 46 connect dend[i](0), dend[44](1)
  connect dend[47](0), dend[26](1)
  for i = 48, 49 connect dend[i](0), dend[i-1](1)
  connect dend[50](0), dend[48](1)
  connect dend[51](0), dend[47](1)
  connect dend[52](0), dend[26](0)
  for i = 53, 54 connect dend[i](0), dend[i-1](1)
  connect dend[55](0), dend[53](1)
  connect dend[56](0), dend[52](1)
  for i = 57, 58 connect dend[i](0), dend[56](1)
  connect dend[59](0), dend[73](1)
  for i = 60, 61 connect dend[i](0), dend[59](1)
  connect dend[62](0), dend[73](1)
  for i = 63, 66 connect dend[i](0), dend[i-1](1)
  connect dend[67](0), dend[65](1)
  connect dend[68](0), dend[64](1)
  connect dend[69](0), dend[63](1)
  connect dend[70](0), dend[62](1)
  for i = 71, 72 connect dend[i](0), dend[70](1)
  connect axon[0](0), soma(0.5)
  for i = 1, 19 connect axon[i](0), axon[i-1](1)
  basic_shape()
}
